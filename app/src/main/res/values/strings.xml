    <!-- 关于 -->
    <string name="about_title">关于 Leafora</string>
    <string name="about_version">版本 %1$s</string>
    <string name="about_body">Leafora 把纸质日记的扫描图片整理成一本可翻阅的电子书。\n所有数据只保存在本机，不需要账号、网络或 API Key。</string>
    <string name="about_privacy_title">本地数据与隐私</string>
    <string name="about_privacy_body">所有日记、扫描图片和设置都只保存在这台设备的应用私有目录中。Leafora 不申请网络权限，不会上传任何内容，也不包含账号、云同步、OCR 或在线 AI。</string>

